{
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#342358",
    "titleBar.activeForeground": "#d8b4fe",
    "titleBar.inactiveBackground": "#281a47",
    "titleBar.inactiveForeground": "#af6fec"
  },

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.quickSuggestions": {
    "strings": true
  },

  // Enable file nesting for unit test files. @link https://github.com/vercel/next.js/blob/ec0279c7a9416cd2b8182167d4e526d2688ae21a/.vscode/settings.json#L70
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "$(capture).test.ts, $(capture).test.tsx, $(capture).stories.tsx",
    "*.tsx": "$(capture).test.ts, $(capture).test.tsx, $(capture).stories.tsx"
  },

  "eslint.validate": ["typescript", "typescriptreact"],
  "eslint.rules.customizations": [{ "rule": "*", "severity": "warn" }],

  "js/ts.tsdk.path": "node_modules/typescript/lib",

  "prettier.documentSelectors": [
    "**/*.{cjs,mjs,ts,tsx,astro,md,json,yaml,yml}"
  ],

  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
